@page "/precio-delivery"
@rendermode InteractiveServer

<PageTitle>Histórico de Precios de Delivery</PageTitle>

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Histórico de Precios de Delivery</h3>
        @if (ultimoPrecioVigente != null)
        {
            <div class="card bg-primary text-white px-3 py-2 shadow-sm">
                <small class="text-uppercase fw-bold">Precio Vigente Actual</small>
                <div class="fs-4 fw-bold">$@ultimoPrecioVigente.Monto.ToString("N2")</div>
            </div>
        }
    </div>

    <!-- Barra de búsqueda / filtro por fecha -->
    <div class="row mb-3 align-items-center">
        <div class="col-md-4 d-flex gap-2">
            <input type="date"
                   class="form-control"
                   @bind="fechaFiltro" />
            @if (fechaFiltro.HasValue)
            {
                <button class="btn btn-outline-secondary" @onclick="() => fechaFiltro = null">
                    Limpiar
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger" role="alert">
            @mensajeError
        </div>
    }

    <!-- Grilla tipo DataGridView -->
    <div class="border rounded bg-white shadow-sm mb-3" style="max-height: 450px; overflow-y: auto;">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-dark position-sticky top-0">
                <tr>
                    <th style="width: 50px;"></th>
                    <th style="width: 100px;">Id</th>
                    <th>Fecha Desde</th>
                    <th style="width: 180px;">Monto</th>
                </tr>
            </thead>
            <tbody>
                @if (cargando)
                {
                    <tr>
                        <td colspan="4" class="text-center py-4">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span class="ms-2">Cargando histórico...</span>
                        </td>
                    </tr>
                }
                else if (!PreciosFiltrados.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">
                            No se encontraron registros de precios.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var p in PreciosFiltrados)
                    {
                        var seleccionado = precioSeleccionado?.Id == p.Id;

                        <tr class="@(seleccionado ? "table-primary fw-bold" : "")"
                            style="cursor: pointer;"
                            @onclick="() => SeleccionarPrecio(p)">
                            <td class="text-center">
                                @if (seleccionado)
                                {
                                    <span>▶</span>
                                }
                            </td>
                            <td>@p.Id</td>
                            <td>@p.FechaDesde.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>$@p.Monto.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Botones de Acción -->
    <div class="d-flex justify-content-center gap-2">
        <button class="btn btn-outline-danger px-4 fw-bold"
                disabled="@(precioSeleccionado == null)"
                @onclick="AbrirModalConfirmarEliminar">
            Eliminar
        </button>

        <button class="btn btn-outline-warning px-4 fw-bold"
                disabled="@(precioSeleccionado == null)"
                @onclick="AbrirModalModificar">
            Actualizar
        </button>

        <button class="btn btn-primary px-4 fw-bold"
                @onclick="AbrirModalAgregar">
            Agregar
        </button>
    </div>
</div>

@* ==========================================
   MODAL 1: AGREGAR / ACTUALIZAR
   ========================================== *@
@if (mostrarModalFormulario)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title">@(esEdicion ? "Actualizar Precio Delivery" : "Agregar Precio Delivery")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(errorModal))
                    {
                        <div class="alert alert-danger py-2">@errorModal</div>
                    }

                    @if (esEdicion)
                    {
                        <div class="mb-3 row">
                            <label class="col-sm-4 col-form-label fw-bold">Id</label>
                            <div class="col-sm-8">
                                <input type="text" class="form-control" value="@precioSeleccionado?.Id" disabled />
                            </div>
                        </div>
                    }

                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-bold">Fecha Desde</label>
                        <div class="col-sm-8">
                            <input type="datetime-local" class="form-control" @bind="formFecha" />
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-bold">Monto ($)</label>
                        <div class="col-sm-8">
                            <input type="number" step="0.01" min="0" class="form-control" @bind="formMonto" placeholder="Monto" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModales" disabled="@guardando">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-primary fw-bold" @onclick="GuardarPrecio" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Aceptar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ==========================================
   MODAL 2: CONFIRMAR ELIMINACIÓN
   ========================================== *@
@if (mostrarModalEliminar && precioSeleccionado != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body text-center">
                    <div class="display-6 text-primary mb-2">?</div>
                    <p class="mb-0">¿Eliminar el registro de precio por $@precioSeleccionado.Monto.ToString("N2") del @precioSeleccionado.FechaDesde.ToString("dd/MM/yyyy")?</p>
                </div>
                <div class="modal-footer d-flex justify-content-center">
                    <button type="button" class="btn btn-primary px-3" @onclick="EliminarPrecioConfirmado" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Sí
                    </button>
                    <button type="button" class="btn btn-secondary px-3" @onclick="CerrarModales" disabled="@guardando">
                        No
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PrecioDeliveryDTO> listaPrecios = new();
    private PrecioDeliveryDTO? precioSeleccionado;
    private DateTime? fechaFiltro;
    private bool cargando = true;
    private string? mensajeError;

    // Modales
    private bool mostrarModalFormulario;
    private bool mostrarModalEliminar;
    private bool esEdicion;
    private bool guardando;
    private string? errorModal;

    // Campos formulario
    private DateTime formFecha = DateTime.Now;
    private decimal formMonto;

    private PrecioDeliveryDTO? ultimoPrecioVigente =>
        listaPrecios.OrderByDescending(p => p.FechaDesde).FirstOrDefault();

    // Filtro por fecha (compara día, mes y año)
    private IEnumerable<PrecioDeliveryDTO> PreciosFiltrados =>
        !fechaFiltro.HasValue
            ? listaPrecios.OrderByDescending(p => p.FechaDesde)
            : listaPrecios.Where(p => p.FechaDesde.Date == fechaFiltro.Value.Date).OrderByDescending(p => p.FechaDesde);

    protected override async Task OnInitializedAsync()
    {
        await CargarPrecios();
    }

    private async Task CargarPrecios()
    {
        cargando = true;
        mensajeError = null;
        try
        {
            var resultado = await PrecioDeliveryApiClient.GetAllAsync();
            listaPrecios = resultado.ToList();
            precioSeleccionado = null;
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar los precios: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void SeleccionarPrecio(PrecioDeliveryDTO precio)
    {
        precioSeleccionado = (precioSeleccionado?.Id == precio.Id) ? null : precio;
    }

    private void AbrirModalAgregar()
    {
        esEdicion = false;
        formFecha = DateTime.Now;
        formMonto = ultimoPrecioVigente?.Monto ?? 0;
        errorModal = null;
        mostrarModalFormulario = true;
    }

    private void AbrirModalModificar()
    {
        if (precioSeleccionado == null) return;

        esEdicion = true;
        formFecha = precioSeleccionado.FechaDesde;
        formMonto = precioSeleccionado.Monto;
        errorModal = null;
        mostrarModalFormulario = true;
    }

    private void AbrirModalConfirmarEliminar()
    {
        if (precioSeleccionado == null) return;
        mostrarModalEliminar = true;
    }

    private void CerrarModales()
    {
        mostrarModalFormulario = false;
        mostrarModalEliminar = false;
        errorModal = null;
    }

    private async Task GuardarPrecio()
    {
        if (formMonto < 0)
        {
            errorModal = "El monto no puede ser negativo.";
            return;
        }

        if (formFecha > DateTime.Now.AddMinutes(5))
        {
            errorModal = "La fecha de inicio no puede ser futura.";
            return;
        }

        guardando = true;
        errorModal = null;

        try
        {
            if (esEdicion && precioSeleccionado != null)
            {
                var dto = new PrecioDeliveryDTO
                {
                    Id = precioSeleccionado.Id,
                    FechaDesde = formFecha,
                    Monto = formMonto
                };

                await PrecioDeliveryApiClient.UpdateAsync(dto);
            }
            else
            {
                var dto = new PrecioDeliveryDTO
                {
                    FechaDesde = formFecha,
                    Monto = formMonto
                };

                await PrecioDeliveryApiClient.AddAsync(dto);
            }

            CerrarModales();
            await CargarPrecios();
        }
        catch (Exception ex)
        {
            errorModal = $"Error al guardar el precio: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarPrecioConfirmado()
    {
        if (precioSeleccionado == null) return;

        guardando = true;
        errorModal = null;

        try
        {
            await PrecioDeliveryApiClient.DeleteAsync(precioSeleccionado.Id);
            CerrarModales();
            await CargarPrecios();
        }
        catch (Exception ex)
        {
            errorModal = $"Error al eliminar el precio: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }
}