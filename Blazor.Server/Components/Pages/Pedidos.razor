@page "/pedidos"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]
@using Application.Services
@inject NotificatorService Notificator
@implements IDisposable
@using DTOs
@using Domain.Model
@using API.Clients

<PageTitle>Gestión de Pedidos</PageTitle>

<div class="container-fluid p-4">
    <h3 class="mb-4">Gestión de Pedidos</h3>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger" role="alert">
            @mensajeError
        </div>
    }

    <!-- Barra de Filtros Superior -->
    <div class="card shadow-sm border mb-4 bg-light">
        <div class="card-body">
            <div class="row align-items-end g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Filtrar por Fecha</label>
                    <div class="input-group">
                        <div class="input-group-text">
                            <input class="form-check-input mt-0" type="checkbox" @bind="filtrarPorFecha" @bind:after="CargarPedidos" />
                        </div>
                        <input type="date" class="form-control" @bind="fechaFiltro" disabled="@(!filtrarPorFecha)" @bind:after="CargarPedidos" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Modalidad</label>
                    <select class="form-select" @bind="modalidadFiltroStr" @bind:after="CargarPedidos">
                        <option value="Todos">Todos</option>
                        <option value="TakeAway">TakeAway</option>
                        <option value="Delivery">Delivery</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-outline-secondary w-100 fw-bold" @onclick="CargarPedidos">
                        Actualizar / Refrescar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Grilla de Pedidos (Izquierda) -->
        <div class="col-lg-7">
            <div class="border rounded bg-white shadow-sm mb-3" style="max-height: 450px; overflow-y: auto;">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark position-sticky top-0">
                        <tr>
                            <th style="width: 40px;"></th>
                            <th>Id</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Modalidad</th>
                            <th>Estado</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cargando)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <div class="spinner-border spinner-border-sm text-primary"></div>
                                    <span class="ms-2">Cargando pedidos...</span>
                                </td>
                            </tr>
                        }
                        else if (!listaPedidos.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No se encontraron registros.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in listaPedidos)
                            {
                                var seleccionado = pedidoSeleccionado?.Id == p.Id;
                                <tr class="@(seleccionado ? "table-primary fw-bold" : "")" style="cursor: pointer;" @onclick="() => SeleccionarPedido(p)">
                                    <td class="text-center">@(seleccionado ? "▶" : "")</td>
                                    <td>@p.Id</td>
                                    <td>@p.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@p.ClienteNombre</td>
                                    <td>@p.Modalidad</td>
                                    <td><span class="badge @ObtenerBadgeEstado(p.Estado)">@p.Estado</span></td>
                                    <td class="text-end fw-bold">$@p.PrecioTotal.ToString("N2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Botones de Acción Administrativa -->
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <button class="btn btn-primary px-3 fw-bold"
                        @onclick="AbrirModalNuevo"
                        disabled="@cargando">
                    + Nuevo pedido
                </button>
                <button class="btn btn-outline-danger px-3 fw-bold" disabled="@(!HabilitarBotonCancelar)" @onclick="CancelarPedido">
                    Cancelar
                </button>
                <button class="btn btn-outline-warning px-3 fw-bold" disabled="@(!HabilitarBotonModificar)" @onclick="AbrirModalModificar">
                    Modificar
                </button>
                <button class="btn btn-outline-info px-3 fw-bold" disabled="@(!HabilitarBotonDelivery)" @onclick="AbrirModalAsignarDelivery">
                    @textoBotonDelivery
                </button>
                <button class="btn btn-success px-4 fw-bold" disabled="@(!HabilitarBotonAvanzar)" @onclick="AvanzarEstadoPedido">
                    @textoBotonAvanzar
                </button>

            </div>
        </div>

        <!-- Detalle Ampliado del Pedido Seleccionado (Derecha) -->
        <div class="col-lg-5">
            <div class="card shadow-sm border mb-3">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">@(pedidoSeleccionado != null ? $"Detalle Ampliado #{pedidoSeleccionado.Id}" : "Detalle del Pedido")</h5>
                </div>
                <div class="card-body bg-light">
                    @if (pedidoSeleccionado == null)
                    {
                        <p class="text-center text-muted my-3">Seleccione un pedido de la lista para ver su información completa.</p>
                    }
                    else
                    {
                        <div class="row g-2 small mb-3">
                            <div class="col-12">
                                <strong>Dirección:</strong> @(string.IsNullOrEmpty(pedidoSeleccionado.Direccion) ? "N/A (TakeAway)" : pedidoSeleccionado.Direccion)
                            </div>
                            <div class="col-12">
                                <strong>Delivery Asignado:</strong> @(string.IsNullOrEmpty(pedidoSeleccionado.DeliveryNombre) ? "Sin asignar" : pedidoSeleccionado.DeliveryNombre)
                            </div>
                            <div class="col-12">
                                <strong>Comentario del Cliente:</strong> @(string.IsNullOrEmpty(pedidoSeleccionado.Comentario) ? "-" : pedidoSeleccionado.Comentario)
                            </div>
                            <div class="col-12">
                                <strong>Comentario Final / Opinión:</strong> @(string.IsNullOrEmpty(pedidoSeleccionado.ComentarioFinal) ? "-" : pedidoSeleccionado.ComentarioFinal)
                            </div>
                            <div class="col-6">
                                <strong>Calif. Pedido:</strong> @(pedidoSeleccionado.CalificacionPedido.HasValue ? $"{pedidoSeleccionado.CalificacionPedido} ★" : "-")
                            </div>
                            <div class="col-6">
                                <strong>Calif. Delivery:</strong> @(pedidoSeleccionado.CalificacionDelivery.HasValue ? $"{pedidoSeleccionado.CalificacionDelivery} ★" : "-")
                            </div>
                        </div>

                        <h6 class="fw-bold text-muted small uppercase mb-2">Ítems del Pedido</h6>
                        <div class="border rounded bg-white shadow-sm" style="max-height: 180px; overflow-y: auto;">
                            <table class="table table-sm table-striped mb-0 align-middle">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Hamburguesa</th>
                                        <th class="text-center" style="width: 50px;">Cant.</th>
                                        <th class="text-end" style="width: 80px;">Unit.</th>
                                        <th class="text-end" style="width: 80px;">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (pedidoSeleccionado.DetallesPedido == null || !pedidoSeleccionado.DetallesPedido.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-2">Sin ítems.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var det in pedidoSeleccionado.DetallesPedido)
                                        {
                                            <tr>
                                                <td>@det.HamburguesaNombre</td>
                                                <td class="text-center">@det.Cantidad</td>
                                                <td class="text-end">$@det.PrecioUnitario.ToString("N2")</td>
                                                <td class="text-end fw-bold">$@((det.Cantidad * det.PrecioUnitario).ToString("N2"))</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* ==========================================
   MODAL: ASIGNAR / CAMBIAR DELIVERY
   ========================================== *@
@if (mostrarModalDelivery)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Asignar Delivery al Pedido #@pedidoSeleccionado?.Id</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(errorModal))
                    {
                        <div class="alert alert-danger py-2">@errorModal</div>
                    }
                    <div class="mb-3">
                        <label class="form-label fw-bold">Seleccione un Delivery</label>
                        <select class="form-select" @bind="deliveryIdSeleccionado">
                            <option value="0">Seleccionar delivery...</option>
                            @foreach (var d in listaDeliveries)
                            {
                                <option value="@d.IdDelivery">@d.Nombre @d.Apellido (DNI: @d.Dni)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModales" disabled="@guardandoModal">Cancelar</button>
                    <button type="button" class="btn btn-primary fw-bold" @onclick="GuardarAsignacionDelivery" disabled="@guardandoModal">
                        @if (guardandoModal)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Asignar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ==========================================
   MODAL: MODIFICAR PEDIDO (ESTADO PENDIENTE)
   ========================================== *@
@if (mostrarModalModificar && pedidoEditando != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">
                        @(esNuevoPedido ? "Nuevo Pedido" : $"Modificar Pedido #{pedidoEditando.Id}")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(errorModal))
                    {
                        <div class="alert alert-danger py-2">@errorModal</div>
                    }
                    @if (esNuevoPedido)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Cliente</label>
                            <select class="form-select" @bind="clienteIdSeleccionado">
                                <option value="0">Seleccionar cliente...</option>
                                @foreach (var cliente in clientesActivos)
                                {
                                    <option value="@cliente.Id">
                                        @cliente.Nombre @cliente.Apellido
                                    </option>
                                }
                            </select>
                            @if (!clientesActivos.Any())
                            {
                                <div class="text-danger small mt-1">
                                    No hay clientes activos disponibles.
                                </div>
                            }
                        </div>
                    }
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Modalidad</label>
                            <select class="form-select" @bind="pedidoEditando.Modalidad">
                                <option value="@ModalidadPedido.TakeAway">TakeAway</option>
                                <option value="@ModalidadPedido.Delivery">Delivery</option>
                            </select>
                        </div>
                        @if (pedidoEditando.Modalidad == ModalidadPedido.Delivery)
                        {
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Dirección de Envío</label>
                                <input type="text" class="form-control" @bind="pedidoEditando.Direccion" placeholder="Dirección..." />
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Comentario</label>
                        <input type="text" class="form-control" @bind="pedidoEditando.Comentario" placeholder="Comentario..." />
                    </div>

                    <!-- Gestión de Ítems dentro del Modal de Modificación -->
                    <div class="card p-3 bg-light mb-3">
                        <h6 class="fw-bold mb-2">Ítems del Pedido</h6>
                        <div class="row align-items-end g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small text-muted">Hamburguesa</label>
                                <select class="form-select form-select-sm" @bind="hamburguesaIdSeleccionada">
                                    <option value="0">Seleccionar hamburguesa...</option>
                                    @foreach (var h in hamburguesasDisponibles)
                                    {
                                        var precio = ObtenerPrecioHamburguesa(h, pedidoEditando.Fecha);
                                        <option value="@h.Id">@h.Nombre - $@precio.ToString("N2")</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-muted">Cantidad</label>
                                <input type="number" class="form-control form-control-sm" min="1" max="50" @bind="cantidadSeleccionada" />
                            </div>
                            <div class="col-md-3">
                                <button class="btn btn-primary btn-sm w-100 fw-bold" @onclick="AgregarItemEdicion">
                                    + Agregar
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive bg-white rounded border" style="max-height: 180px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Hamburguesa</th>
                                        <th class="text-end" style="width: 100px;">Precio Unit.</th>
                                        <th class="text-center" style="width: 80px;">Cant.</th>
                                        <th class="text-end" style="width: 100px;">Subtotal</th>
                                        <th style="width: 40px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (pedidoEditando.DetallesPedido == null || !pedidoEditando.DetallesPedido.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-2">Sin ítems en el pedido.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var det in pedidoEditando.DetallesPedido)
                                        {
                                            <tr>
                                                <td>@det.HamburguesaNombre</td>
                                                <td class="text-end">$@det.PrecioUnitario.ToString("N2")</td>
                                                <td class="text-center">@det.Cantidad</td>
                                                <td class="text-end fw-bold">$@((det.Cantidad * det.PrecioUnitario).ToString("N2"))</td>
                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-outline-danger py-0 px-1" @onclick="() => EliminarItemEdicion(det)">✕</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="text-end fw-bold fs-5">
                        @if (pedidoEditando.Modalidad == ModalidadPedido.Delivery)
                        {
                            <div class="small text-muted">
                                Envío: $@ObtenerPrecioDelivery(pedidoEditando.Fecha).ToString("N2")
                            </div>
                        }
                        <div>
                            Total: <span class="text-success">
                                $@CalcularTotalPedido(pedidoEditando).ToString("N2")
                            </span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModales" disabled="@guardandoModal">Cancelar</button>
                    <button type="button"
                            class="btn btn-primary fw-bold"
                            @onclick="GuardarModificacionPedido"
                            disabled="@guardandoModal">
                        @if (guardandoModal)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        @(esNuevoPedido ? "Crear Pedido" : "Guardar Cambios")
                    </button>
                </div>
            </div>
        </div>
    </div>
}
@if (mostrarModalConfirmacion)
{
    <div class="modal fade show d-block" tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Confirmar acción</h5>
                    <button type="button" class="btn-close"
                            @onclick="CerrarModalConfirmacion"
                            disabled="@guardandoConfirmacion">
                    </button>
                </div>

                <div class="modal-body">
                    @mensajeConfirmacion

                    @if (!string.IsNullOrWhiteSpace(errorConfirmacion))
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            @errorConfirmacion
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            @onclick="CerrarModalConfirmacion"
                            disabled="@guardandoConfirmacion">
                        Volver
                    </button>

                    <button type="button"
                            class="btn @(esCancelacion ? "btn-danger" : "btn-primary")"
                            @onclick="ConfirmarCambioEstado"
                            disabled="@guardandoConfirmacion">
                        @(guardandoConfirmacion ? "Procesando..." : "Confirmar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}
@code {
    private List<PedidoDTO> listaPedidos = new();
    private List<DeliveryDTO> listaDeliveries = new();
    private List<HamburguesaDTO> hamburguesasDisponibles = new();
    private List<ClienteDTO> clientesActivos = new();
    private List<PrecioDeliveryDTO> preciosDelivery = new();

    private bool esNuevoPedido;
    private int clienteIdSeleccionado;
    private PedidoDTO? pedidoSeleccionado;

    private bool filtrarPorFecha = false;
    private DateTime fechaFiltro = DateTime.Today;
    private string modalidadFiltroStr = "Todos";

    private bool cargando = true;
    private string? mensajeError;

    private bool HabilitarBotonCancelar;
    private bool HabilitarBotonModificar;
    private bool HabilitarBotonDelivery;
    private bool HabilitarBotonAvanzar;
    private string textoBotonAvanzar = "Avanzar Estado";
    private string textoBotonDelivery = "Asignar Delivery";
    private EstadoPedido? estadoSiguiente;
    private bool mostrarModalConfirmacion;
    private bool guardandoConfirmacion;
    private bool esCancelacion;
    private string mensajeConfirmacion = string.Empty;
    private string? errorConfirmacion;
    private EstadoPedido? estadoAnteriorConfirmacion;
    // Modales
    private bool mostrarModalDelivery;
    private int deliveryIdSeleccionado;

    private bool mostrarModalModificar;
    private PedidoDTO? pedidoEditando;
    private int hamburguesaIdSeleccionada;
    private int cantidadSeleccionada = 1;

    private bool guardandoModal;
    private string? errorModal;

    protected override async Task OnInitializedAsync()
    {
        Notificator.OnPedidosChanged += StateHasChangedCallback; 
        await CargarCatalogos();
        await CargarPedidos();
    }

    private void StateHasChangedCallback()
    {
        _ = InvokeAsync(async () =>
        {
            await CargarPedidos();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Notificator.OnPedidosChanged -= StateHasChangedCallback; 
    }

    private async Task CargarCatalogos()
    {
        try
        {
            var clientesTask = ClienteApiClient.GetAllAsync();
            var deliveriesTask = DeliveryApiClient.GetAllAsync();
            var hamburguesasTask = HamburguesaApiClient.GetAllAsync();
            var preciosDeliveryTask = PrecioDeliveryApiClient.GetAllAsync();

            var todosClientes = (await clientesTask)?.ToList() ?? new();
            clientesActivos = todosClientes.Where(c => c.Activo).ToList();

            var todosDeliveries = (await deliveriesTask)?.ToList() ?? new();
            listaDeliveries = todosDeliveries.Where(d => d.Activo).ToList();

            var todasHamburguesas = (await hamburguesasTask)?.ToList() ?? new();
            hamburguesasDisponibles = todasHamburguesas
                .Where(h => h.Activo)
                .ToList();

            preciosDelivery = (await preciosDeliveryTask)?.ToList() ?? new();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar los catálogos: {ex.Message}";
            clientesActivos = new();
            listaDeliveries = new();
            hamburguesasDisponibles = new();
            preciosDelivery = new();
        }
    }


    private async Task CargarPedidos()
    {
        cargando = true;
        mensajeError = null;
        try
        {
            DateTime? fechaParam = filtrarPorFecha ? fechaFiltro.Date : null;
            ModalidadPedido? modalidadParam = modalidadFiltroStr == "Todos" ? null : Enum.Parse<ModalidadPedido>(modalidadFiltroStr);

            var resultado = await PedidoApiClient.GetByFiltroAsync(fechaParam, modalidadParam);
            listaPedidos = resultado?.ToList() ?? new();
            pedidoSeleccionado = null;
            ActualizarBotonera();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar los pedidos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void SeleccionarPedido(PedidoDTO p)
    {
        pedidoSeleccionado = (pedidoSeleccionado?.Id == p.Id) ? null : p;
        ActualizarBotonera();
    }

    private void ActualizarBotonera()
    {
        HabilitarBotonCancelar = false;
        HabilitarBotonModificar = false;
        HabilitarBotonDelivery = false;
        HabilitarBotonAvanzar = false;
        textoBotonAvanzar = "Avanzar Estado";
        textoBotonDelivery = "Asignar Delivery";
        estadoSiguiente = null;

        if (pedidoSeleccionado == null) return;

        if (pedidoSeleccionado.Estado == EstadoPedido.Entregado || pedidoSeleccionado.Estado == EstadoPedido.Cancelado)
        {
            return;
        }

        if (pedidoSeleccionado.Estado == EstadoPedido.Pendiente)
        {
            HabilitarBotonCancelar = true;
            HabilitarBotonModificar = true;

            if (pedidoSeleccionado.Modalidad == ModalidadPedido.Delivery)
            {
                HabilitarBotonDelivery = true;
                textoBotonDelivery = "Asignar Delivery";
            }
            else
            {
                HabilitarBotonAvanzar = true;
                textoBotonAvanzar = "Avanzar a: En Proceso";
                estadoSiguiente = EstadoPedido.EnProceso;
            }
        }
        else if (pedidoSeleccionado.Modalidad == ModalidadPedido.TakeAway)
        {
            if (pedidoSeleccionado.Estado == EstadoPedido.EnProceso)
            {
                HabilitarBotonAvanzar = true;
                textoBotonAvanzar = "Avanzar a: Listo";
                estadoSiguiente = EstadoPedido.Listo;
            }
            else if (pedidoSeleccionado.Estado == EstadoPedido.Listo)
            {
                HabilitarBotonAvanzar = true;
                textoBotonAvanzar = "Entregar al Cliente";
                estadoSiguiente = EstadoPedido.Entregado;
            }
        }
        else if (pedidoSeleccionado.Modalidad == ModalidadPedido.Delivery)
        {
            if (pedidoSeleccionado.Estado == EstadoPedido.Asignado)
            {
                HabilitarBotonAvanzar = true;
                textoBotonAvanzar = "Avanzar a: En Camino";
                estadoSiguiente = EstadoPedido.EnCamino;

                HabilitarBotonDelivery = true;
                textoBotonDelivery = "Cambiar Delivery";
            }
            else if (pedidoSeleccionado.Estado == EstadoPedido.EnCamino)
            {
                HabilitarBotonAvanzar = true;
                textoBotonAvanzar = "Marcar como Entregado";
                estadoSiguiente = EstadoPedido.Entregado;
            }
        }
    }

    private void CancelarPedido()
    {
        if (pedidoSeleccionado == null ||
            pedidoSeleccionado.Estado == EstadoPedido.Entregado ||
            pedidoSeleccionado.Estado == EstadoPedido.Cancelado)
            return;

        esCancelacion = true;
        estadoAnteriorConfirmacion = pedidoSeleccionado.Estado;
        errorConfirmacion = null;

        mensajeConfirmacion =
            $"¿Estás seguro de que querés cancelar el pedido #{pedidoSeleccionado.Id}?";

        mostrarModalConfirmacion = true;
    }

    private void AvanzarEstadoPedido()
    {
        if (pedidoSeleccionado == null || !estadoSiguiente.HasValue)
            return;

        esCancelacion = false;
        estadoAnteriorConfirmacion = pedidoSeleccionado.Estado;
        errorConfirmacion = null;

        mensajeConfirmacion =
            $"¿Querés cambiar el estado del pedido #{pedidoSeleccionado.Id} " +
            $"de {pedidoSeleccionado.Estado} a {estadoSiguiente.Value}?";

        mostrarModalConfirmacion = true;
    }

    private void CerrarModalConfirmacion()
    {
        if (guardandoConfirmacion)
            return;

        mostrarModalConfirmacion = false;
        errorConfirmacion = null;
    }

    private async Task ConfirmarCambioEstado()
    {
        if (pedidoSeleccionado == null)
            return;

        var pedido = pedidoSeleccionado;
        var estadoAnterior = estadoAnteriorConfirmacion;

        // Volvemos a validar antes de guardar.
        if (estadoAnterior != pedido.Estado)
        {
            errorConfirmacion = "El estado del pedido cambió. Actualizá la lista e intentá nuevamente.";
            return;
        }

        if (esCancelacion &&
            (pedido.Estado == EstadoPedido.Entregado ||
             pedido.Estado == EstadoPedido.Cancelado))
        {
            errorConfirmacion = "Este pedido ya no se puede cancelar.";
            return;
        }

        if (!esCancelacion &&
            (!estadoSiguiente.HasValue ||
             !PuedeAvanzarA(pedido.Estado, estadoSiguiente.Value, pedido.Modalidad)))
        {
            errorConfirmacion = "No se puede realizar esa transición de estado.";
            return;
        }

        guardandoConfirmacion = true;
        errorConfirmacion = null;

        try
        {
            pedido.Estado = esCancelacion
                ? EstadoPedido.Cancelado
                : estadoSiguiente!.Value;

            await PedidoApiClient.UpdateAsync(pedido);

            mostrarModalConfirmacion = false;
            Notificator.NotificarCambioPedidos();

            await CargarPedidos();
        }
        catch (Exception ex)
        {
            pedido.Estado = estadoAnterior!.Value;
            errorConfirmacion = $"No se pudo actualizar el pedido: {ex.Message}";
        }
        finally
        {
            guardandoConfirmacion = false;
        }
    }

    private bool PuedeAvanzarA(
        EstadoPedido actual,
        EstadoPedido siguiente,
        ModalidadPedido modalidad)
    {
        if (modalidad == ModalidadPedido.TakeAway)
        {
            return (actual == EstadoPedido.Pendiente &&
                    siguiente == EstadoPedido.EnProceso)
                || (actual == EstadoPedido.EnProceso &&
                    siguiente == EstadoPedido.Listo)
                || (actual == EstadoPedido.Listo &&
                    siguiente == EstadoPedido.Entregado);
        }

        if (modalidad == ModalidadPedido.Delivery)
        {
            return (actual == EstadoPedido.Asignado &&
                    siguiente == EstadoPedido.EnCamino)
                || (actual == EstadoPedido.EnCamino &&
                    siguiente == EstadoPedido.Entregado);
        }

        return false;
    }

    private async Task AbrirModalModificar()
    {
        if (pedidoSeleccionado == null ||
            pedidoSeleccionado.Estado != EstadoPedido.Pendiente)
            return;

        errorModal = null;
        esNuevoPedido = false;
        hamburguesaIdSeleccionada = 0;
        cantidadSeleccionada = 1;

        try
        {
            await CargarCatalogos();

            pedidoEditando = new PedidoDTO
            {
                Id = pedidoSeleccionado.Id,
                Fecha = pedidoSeleccionado.Fecha,
                ClienteId = pedidoSeleccionado.ClienteId,
                ClienteNombre = pedidoSeleccionado.ClienteNombre,
                Modalidad = pedidoSeleccionado.Modalidad,
                Direccion = pedidoSeleccionado.Direccion,
                Comentario = pedidoSeleccionado.Comentario,
                Estado = pedidoSeleccionado.Estado,
                PrecioTotal = pedidoSeleccionado.PrecioTotal,
                DeliveryId = pedidoSeleccionado.DeliveryId,
                DetallesPedido = pedidoSeleccionado.DetallesPedido?
                    .Select(d => new DetallePedidoDTO
                    {
                        Id = d.Id,
                        PedidoId = d.PedidoId,
                        HamburguesaId = d.HamburguesaId,
                        HamburguesaNombre = d.HamburguesaNombre,
                        PrecioUnitario = d.PrecioUnitario,
                        Cantidad = d.Cantidad
                    }).ToList() ?? new()
            };

            // En edición solo se ofrecen hamburguesas activas para agregar.
            mostrarModalModificar = true;
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al preparar la modificación: {ex.Message}";
        }
    }



    private void AgregarItemEdicion()
    {
        if (pedidoEditando == null)
            return;

        if (hamburguesaIdSeleccionada <= 0)
        {
            errorModal = "Debe seleccionar una hamburguesa.";
            return;
        }

        if (cantidadSeleccionada < 1 || cantidadSeleccionada > 50)
        {
            errorModal = "La cantidad debe estar entre 1 y 50.";
            return;
        }

        var hamburguesa = hamburguesasDisponibles
            .FirstOrDefault(h => h.Id == hamburguesaIdSeleccionada && h.Activo);

        if (hamburguesa == null)
        {
            errorModal = "La hamburguesa seleccionada no está disponible.";
            return;
        }

        var precio = ObtenerPrecioHamburguesa(hamburguesa, pedidoEditando.Fecha);

        if (precio <= 0)
        {
            errorModal = $"La hamburguesa {hamburguesa.Nombre} no tiene un precio válido.";
            return;
        }

        var itemExistente = pedidoEditando.DetallesPedido
            .FirstOrDefault(i => i.HamburguesaId == hamburguesa.Id);

        if (itemExistente != null)
        {
            if (itemExistente.Cantidad + cantidadSeleccionada > 50)
            {
                errorModal = "La cantidad total de una hamburguesa no puede superar 50.";
                return;
            }

            itemExistente.Cantidad += cantidadSeleccionada;
        }
        else
        {
            pedidoEditando.DetallesPedido.Add(new DetallePedidoDTO
            {
                HamburguesaId = hamburguesa.Id,
                HamburguesaNombre = hamburguesa.Nombre,
                PrecioUnitario = precio,
                Cantidad = cantidadSeleccionada
            });
        }

        errorModal = null;
        hamburguesaIdSeleccionada = 0;
        cantidadSeleccionada = 1;
    }


    private void EliminarItemEdicion(DetallePedidoDTO item)
    {
        pedidoEditando?.DetallesPedido.Remove(item);
    }


    private async Task GuardarModificacionPedido()
    {
        if (pedidoEditando == null || guardandoModal)
            return;

        errorModal = null;

        if (esNuevoPedido)
        {
            if (!clientesActivos.Any(c => c.Id == clienteIdSeleccionado && c.Activo))
            {
                errorModal = "Debe seleccionar un cliente activo.";
                return;
            }
        }

        if (pedidoEditando.Modalidad == ModalidadPedido.Delivery &&
            string.IsNullOrWhiteSpace(pedidoEditando.Direccion))
        {
            errorModal = "La dirección es obligatoria para pedidos con delivery.";
            return;
        }

        if (pedidoEditando.DetallesPedido == null ||
            !pedidoEditando.DetallesPedido.Any())
        {
            errorModal = "El pedido debe tener al menos un ítem.";
            return;
        }

        if (pedidoEditando.DetallesPedido.Any(d => d.Cantidad < 1 || d.Cantidad > 50))
        {
            errorModal = "Cada ítem debe tener una cantidad entre 1 y 50.";
            return;
        }

        if (pedidoEditando.Modalidad == ModalidadPedido.Delivery &&
            !preciosDelivery.Any())
        {
            errorModal = "No hay precios de delivery configurados.";
            return;
        }

        guardandoModal = true;

        try
        {
            if (esNuevoPedido)
            {
                pedidoEditando.ClienteId = clienteIdSeleccionado;
                pedidoEditando.Estado = EstadoPedido.Pendiente;
                pedidoEditando.Fecha = DateTime.Now;
                pedidoEditando.DeliveryId = null;
            }

            if (pedidoEditando.Modalidad == ModalidadPedido.TakeAway)
            {
                pedidoEditando.Direccion = null;
                pedidoEditando.DeliveryId = null;
            }
            else
            {
                pedidoEditando.Direccion = pedidoEditando.Direccion?.Trim();
            }

            pedidoEditando.PrecioTotal = CalcularTotalPedido(pedidoEditando);

            if (esNuevoPedido)
            {
                await PedidoApiClient.AddAsync(pedidoEditando);
            }
            else
            {
                await PedidoApiClient.UpdateAsync(pedidoEditando);
            }

            CerrarModales();
            await CargarPedidos();

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            errorModal = esNuevoPedido
                ? $"Error al crear el pedido: {ex.Message}"
                : $"Error al actualizar el pedido: {ex.Message}";
        }
        finally
        {
            guardandoModal = false;
        }
    }


    private async Task AbrirModalAsignarDelivery()
    {
        if (pedidoSeleccionado == null) return;

        try
        {
            
            var todosDeliveries = (await DeliveryApiClient.GetAllAsync())?.ToList() ?? new();
            listaDeliveries = todosDeliveries
    .Where(d => d.Activo)
    .ToList();
        }
        catch
        {
            listaDeliveries = new();
        }

        deliveryIdSeleccionado = pedidoSeleccionado.DeliveryId ?? 0;
        errorModal = null;
        mostrarModalDelivery = true;
    }

    private void CerrarModales()
    {
        mostrarModalDelivery = false;
        mostrarModalModificar = false;
        errorModal = null;
        esNuevoPedido = false;
        pedidoEditando = null;
        clienteIdSeleccionado = 0;
        hamburguesaIdSeleccionada = 0;
        cantidadSeleccionada = 1;
    }


    private async Task GuardarAsignacionDelivery()
    {
        if (pedidoSeleccionado == null || deliveryIdSeleccionado <= 0)
        {
            errorModal = "Debe seleccionar un delivery válido.";
            return;
        }

        // Verificar que el delivery seleccionado esté activo.
        var deliveryActivo = listaDeliveries.Any(d =>
            d.IdDelivery == deliveryIdSeleccionado && d.Activo);

        if (!deliveryActivo)
        {
            errorModal = "Debe seleccionar un delivery activo.";
            return;
        }

        guardandoModal = true;
        errorModal = null;

        try
        {
            pedidoSeleccionado.DeliveryId = deliveryIdSeleccionado;
            pedidoSeleccionado.Estado = EstadoPedido.Asignado;

            await PedidoApiClient.UpdateAsync(pedidoSeleccionado);

            CerrarModales();
            await CargarPedidos();
        }
        catch (Exception ex)
        {
            errorModal = $"Error al asignar delivery: {ex.Message}";
        }
        finally
        {
            guardandoModal = false;
        }
    }

    private async Task AbrirModalNuevo()
    {
        errorModal = null;
        mensajeError = null;
        hamburguesaIdSeleccionada = 0;
        cantidadSeleccionada = 1;
        clienteIdSeleccionado = 0;
        esNuevoPedido = true;

        try
        {
            await CargarCatalogos();

            if (!clientesActivos.Any())
            {
                errorModal = "No hay clientes activos para crear un pedido.";
            }

            if (!hamburguesasDisponibles.Any())
            {
                errorModal = "No hay hamburguesas activas disponibles.";
            }

            pedidoEditando = new PedidoDTO
            {
                Fecha = DateTime.Now,
                Estado = EstadoPedido.Pendiente,
                Modalidad = ModalidadPedido.TakeAway,
                Direccion = null,
                Comentario = string.Empty,
                DetallesPedido = new List<DetallePedidoDTO>()
            };

            mostrarModalModificar = true;
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al preparar el nuevo pedido: {ex.Message}";
        }
    }
    private decimal ObtenerPrecioHamburguesa(HamburguesaDTO hamburguesa, DateTime fechaPedido)
    {
        var precios = hamburguesa.Precios?.ToList() ?? new();

        if (!precios.Any())
            return 0m;

        var precioAnterior = precios
            .Where(p => p.FechaDesde.Date <= fechaPedido.Date)
            .OrderByDescending(p => p.FechaDesde)
            .FirstOrDefault();

        if (precioAnterior != null)
            return precioAnterior.Monto;

        // Si no existe un precio anterior, elegir el posterior más cercano.
        return precios
            .Where(p => p.FechaDesde.Date > fechaPedido.Date)
            .OrderBy(p => p.FechaDesde)
            .First()
            .Monto;
    }

    private decimal ObtenerPrecioDelivery(DateTime fechaPedido)
    {
        if (!preciosDelivery.Any())
            return 0m;

        var precioAnterior = preciosDelivery
            .Where(p => p.FechaDesde.Date <= fechaPedido.Date)
            .OrderByDescending(p => p.FechaDesde)
            .FirstOrDefault();

        if (precioAnterior != null)
            return precioAnterior.Monto;

        // Si no existe un precio anterior, elegir el posterior más cercano.
        return preciosDelivery
            .Where(p => p.FechaDesde.Date > fechaPedido.Date)
            .OrderBy(p => p.FechaDesde)
            .First()
            .Monto;
    }

    private decimal CalcularTotalPedido(PedidoDTO pedido)
    {
        var totalHamburguesas = pedido.DetallesPedido?
            .Sum(d => d.Cantidad * d.PrecioUnitario) ?? 0m;

        var envio = pedido.Modalidad == ModalidadPedido.Delivery
            ? ObtenerPrecioDelivery(pedido.Fecha)
            : 0m;

        return totalHamburguesas + envio;
    }

    private string ObtenerBadgeEstado(EstadoPedido estado) => estado switch
    {
        EstadoPedido.Pendiente => "bg-warning text-dark",
        EstadoPedido.EnProceso => "bg-info text-dark",
        EstadoPedido.Listo => "bg-primary",
        EstadoPedido.Asignado => "bg-secondary",
        EstadoPedido.EnCamino => "bg-primary",
        EstadoPedido.Entregado => "bg-success",
        EstadoPedido.Cancelado => "bg-danger",
        _ => "bg-secondary"
    };
}