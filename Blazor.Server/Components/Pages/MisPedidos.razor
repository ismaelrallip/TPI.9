@page "/cliente/mis-pedidos"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Cliente")]
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using Application.Services
@inject NotificatorService Notificator
@implements IDisposable
@using DTOs
@using Domain.Model
@using API.Clients

<PageTitle>Mis Pedidos</PageTitle>

<div class="container-fluid p-4">
    <h3 class="mb-4">Mis Pedidos</h3>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger" role="alert">
            @mensajeError
        </div>
    }

    <div class="row g-4">
        <!-- Listado de Pedidos (Izquierda) -->
        <div class="col-lg-7">
            <div class="card shadow-sm border mb-3">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Historial de Pedidos</h5>
                    <button class="btn btn-sm btn-outline-light fw-bold" @onclick="CargarMisPedidos">Refrescar</button>
                </div>
                <div class="card-body p-0">
                    <div class="border rounded bg-white shadow-sm" style="max-height: 420px; overflow-y: auto;">
                        <table class="table table-hover table-striped mb-0 align-middle">
                            <thead class="table-dark position-sticky top-0">
                                <tr>
                                    <th style="width: 40px;"></th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                    <th>Modalidad</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-center">Calif.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (cargando)
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4">
                                            <div class="spinner-border spinner-border-sm text-primary"></div>
                                            <span class="ms-2">Cargando mis pedidos...</span>
                                        </td>
                                    </tr>
                                }
                                else if (!pedidosFiltrados.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">No tenés pedidos registrados.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var p in pedidosFiltrados)
                                    {
                                        var selec = pedidoSeleccionado?.Id == p.Id;
                                        <tr class="@(selec ? "table-primary fw-bold" : "")" style="cursor: pointer;" @onclick="() => SeleccionarPedido(p)">
                                            <td class="text-center">@(selec ? "▶" : "")</td>
                                            <td>@p.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge @ObtenerBadgeEstado(p.Estado)">@p.Estado</span>
                                            </td>
                                            <td>@p.Modalidad</td>
                                            <td class="text-end fw-bold">$@p.PrecioTotal.ToString("N2")</td>
                                            <td class="text-center">
                                                @(p.CalificacionPedido.HasValue ? $"★ {p.CalificacionPedido}" : "-")
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>


            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-danger fw-bold px-4"
                        disabled="@(pedidoSeleccionado == null || pedidoSeleccionado.Estado != EstadoPedido.Pendiente)"
                        @onclick="CancelarPedido">
                    Cancelar Pedido
                </button>

                <button class="btn btn-outline-warning fw-bold px-4"
                        disabled="@(pedidoSeleccionado == null || pedidoSeleccionado.Estado != EstadoPedido.Pendiente)"
                        @onclick="EditarPedido">
                    Editar Pedido
                </button>

                <button class="btn btn-outline-primary fw-bold px-4"
                        disabled="@(pedidoSeleccionado == null || pedidoSeleccionado.Estado != EstadoPedido.Entregado || pedidoSeleccionado.CalificacionPedido.HasValue)"
                        @onclick="AbrirModalCalificar">
                    @(pedidoSeleccionado?.CalificacionPedido.HasValue == true ? "Ya Calificado" : "Comentar / Calificar")
                </button>
            </div>
        </div> <!-- Cierra col-lg-7 -->
        <!-- Filtros y Detalle (Derecha) -->
        <div class="col-lg-5">
            <!-- Card Filtros -->
            <div class="card shadow-sm border mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Filtrar Pedidos</h5>
                </div>
                <div class="card-body">
                    <div class="mb-0">
                        <label class="form-label fw-bold">Estado</label>
                        <select class="form-select" @bind="filtroEstadoStr" @bind:after="AplicarFiltros">
                            <option value="Todos">Todos</option>
                            <option value="@EstadoPedido.Pendiente">Pendiente</option>
                            <option value="@EstadoPedido.EnProceso">En Proceso</option>
                            <option value="@EstadoPedido.EnCamino">En Camino</option>
                            <option value="@EstadoPedido.Entregado">Entregado</option>
                            <option value="@EstadoPedido.Cancelado">Cancelado</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Card Detalle del Pedido Seleccionado -->
            <div class="card shadow-sm border mb-3">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        @(pedidoSeleccionado != null ? $"Detalle Pedido #{pedidoSeleccionado.Id}" : "Detalle del Pedido")
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="border rounded bg-white shadow-sm" style="max-height: 220px; overflow-y: auto;">
                        <table class="table table-sm table-striped mb-0 align-middle">
                            <thead class="table-dark position-sticky top-0">
                                <tr>
                                    <th>Hamburguesa</th>
                                    <th class="text-center" style="width: 80px;">Cant.</th>
                                    <th class="text-end" style="width: 120px;">Precio Unit.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (pedidoSeleccionado == null)
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">Selecciona un pedido de la lista.</td>
                                    </tr>
                                }
                                else if (pedidoSeleccionado.DetallesPedido == null || !pedidoSeleccionado.DetallesPedido.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">Sin ítems detallados.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var det in pedidoSeleccionado.DetallesPedido)
                                    {
                                        <tr>
                                            <td>@det.HamburguesaNombre</td>
                                            <td class="text-center">@det.Cantidad</td>
                                            <td class="text-end">$@det.PrecioUnitario.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button class="btn btn-primary fw-bold px-4" @onclick="NavegarNuevoPedido">
                    + Nuevo Pedido
                </button>
            </div>
        </div>
    </div>
</div>

@* ==========================================
   MODAL: CALIFICAR / COMENTAR PEDIDO
   ========================================== *@
@if (mostrarModalCalificar && pedidoSeleccionado != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Calificar Pedido #@pedidoSeleccionado.Id</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(errorModal))
                    {
                        <div class="alert alert-danger py-2">@errorModal</div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">Calificación del Pedido (1 a 5 estrellas)</label>
                        <select class="form-select" @bind="califPedido">
                            <option value="5">5 ★★★★★ Excelente</option>
                            <option value="4">4 ★★★★☆ Muy Bueno</option>
                            <option value="3">3 ★★★☆☆ Bueno</option>
                            <option value="2">2 ★★☆☆☆ Regular</option>
                            <option value="1">1 ★☆☆☆☆ Malo</option>
                        </select>
                    </div>

                    @if (pedidoSeleccionado.Modalidad == ModalidadPedido.Delivery)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Calificación del Delivery (1 a 5 estrellas)</label>
                            <select class="form-select" @bind="califDelivery">
                                <option value="5">5 ★★★★★ Excelente</option>
                                <option value="4">4 ★★★★☆ Muy Bueno</option>
                                <option value="3">3 ★★★☆☆ Bueno</option>
                                <option value="2">2 ★★☆☆☆ Regular</option>
                                <option value="1">1 ★☆☆☆☆ Malo</option>
                            </select>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">Comentario u Opinión</label>
                        <textarea class="form-control" rows="3" @bind="comentarioFinal" placeholder="Escribí un comentario sobre tu experiencia..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModales" disabled="@guardandoModal">Cancelar</button>
                    <button type="button" class="btn btn-primary fw-bold" @onclick="GuardarCalificacion" disabled="@guardandoModal">
                        @if (guardandoModal)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Aceptar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ==========================================
   MODAL: EDITAR PEDIDO
   ========================================== *@
@if (mostrarModalEditar && pedidoSeleccionado != null)
{
    <div class="modal fade show d-block" tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        Editar Pedido #@pedidoSeleccionado.Id
                    </h5>
                    <button type="button" class="btn-close"
                            disabled="@guardandoEdicion"
                            @onclick="CerrarModalEdicion">
                    </button>
                </div>

                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(errorEdicion))
                    {
                        <div class="alert alert-danger py-2">
                            @errorEdicion
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">Modalidad</label>
                        <select class="form-select" @bind="modalidadEdicion">
                            <option value="@ModalidadPedido.TakeAway">
                                Retiro en local
                            </option>
                            <option value="@ModalidadPedido.Delivery">
                                Delivery
                            </option>
                        </select>
                    </div>

                    @if (modalidadEdicion == ModalidadPedido.Delivery)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Dirección de entrega
                            </label>
                            <input class="form-control"
                                   @bind="direccionEdicion"
                                   placeholder="Ingresá la dirección" />
                            <div class="form-text">
                                Costo de delivery:
                                @precioDeliveryEdicion.ToString("C")
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Comentario del pedido
                        </label>
                        <textarea class="form-control" rows="2"
                                  @bind="comentarioEdicion"
                                  placeholder="Comentario opcional">
                            </textarea>
                    </div>

                    <hr />

                    <h6 class="fw-bold">Agregar hamburguesas</h6>

                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-md-7">
                            <label class="form-label">Hamburguesa</label>
                            <select class="form-select"
                                    @bind="hamburguesaIdEdicion">
                                @foreach (var h in hamburguesasEdicion)
                                {
                                    <option value="@h.Id">@h.Nombre</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Cantidad</label>
                            <input type="number"
                                   class="form-control"
                                   min="1" max="50"
                                   @bind="cantidadEdicion" />
                        </div>

                        <div class="col-md-3">
                            <button type="button"
                                    class="btn btn-success w-100"
                                    disabled="@(hamburguesasEdicion.Count == 0 || guardandoEdicion)"
                                    @onclick="AgregarItemEdicion">
                                Agregar
                            </button>
                        </div>
                    </div>

                    <h6 class="fw-bold">Productos del pedido</h6>

                    @if (itemsEdicion.Count == 0)
                    {
                        <p class="text-muted">
                            Todavía no hay productos en el pedido.
                        </p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle">
                                <thead>
                                    <tr>
                                        <th>Hamburguesa</th>
                                        <th style="width: 100px;">Cantidad</th>
                                        <th>Precio unitario</th>
                                        <th>Subtotal</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in itemsEdicion)
                                    {
                                        <tr @key="item.HamburguesaId">
                                            <td>@item.HamburguesaNombre</td>
                                            <td>
                                                <input type="number"
                                                       class="form-control form-control-sm"
                                                       min="1" max="50"
                                                       @bind="item.Cantidad"
                                                       disabled="@guardandoEdicion" />
                                            </td>
                                            <td>
                                                @item.PrecioUnitario.ToString("C")
                                            </td>
                                            <td>
                                                @((item.Cantidad * item.PrecioUnitario).ToString("C"))
                                            </td>
                                            <td>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        disabled="@guardandoEdicion"
                                                        @onclick="() => EliminarItemEdicion(item)">
                                                    Quitar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="text-end fs-5 fw-bold mt-3">
                        Total: @TotalEdicion.ToString("C")
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@guardandoEdicion"
                            @onclick="CerrarModalEdicion">
                        Volver
                    </button>

                    <button type="button"
                            class="btn btn-primary fw-bold"
                            disabled="@guardandoEdicion"
                            @onclick="GuardarEdicionPedido">
                        @(guardandoEdicion ? "Guardando..." : "Guardar cambios")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    
    

    private List<PedidoDTO> todosLosPedidos = new();
    private List<PedidoDTO> pedidosFiltrados = new();
    private PedidoDTO? pedidoSeleccionado;

    private string filtroEstadoStr = "Todos";
    private bool cargando = true;
    private string? mensajeError;

    private bool mostrarModalCalificar;
    private int califPedido = 5;
    private int califDelivery = 5;
    private string comentarioFinal = string.Empty;
    private bool guardandoModal;
    private string? errorModal;

    protected override async Task OnInitializedAsync()
    {
        Notificator.OnPedidosChanged += StateHasChangedCallback;
        await CargarMisPedidos();
    }

    private void StateHasChangedCallback()
    {
        _ = InvokeAsync(async () =>
        {
            await CargarMisPedidos();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Notificator.OnPedidosChanged -= StateHasChangedCallback;
    }

    private async Task CargarMisPedidos()
    {
        cargando = true;
        mensajeError = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var clienteIdClaim = user.FindFirst("clienteId")?.Value;

            if (string.IsNullOrWhiteSpace(clienteIdClaim) ||
                !int.TryParse(clienteIdClaim, out int clienteId))
            {
                mensajeError = "No se pudo identificar al cliente en la sesión.";
                todosLosPedidos.Clear();
                pedidosFiltrados.Clear();
                return;
            }

            var res = await PedidoApiClient.GetByClienteIdAsync(clienteId);

            var idSeleccionadoAnterior = pedidoSeleccionado?.Id;

            todosLosPedidos = res?.ToList() ?? new List<PedidoDTO>();
            AplicarFiltros();

            pedidoSeleccionado = idSeleccionadoAnterior.HasValue
                ? pedidosFiltrados.FirstOrDefault(p => p.Id == idSeleccionadoAnterior.Value)
                : null;
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al obtener pedidos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AplicarFiltros()
    {
        if (filtroEstadoStr == "Todos")
        {
            pedidosFiltrados = todosLosPedidos.ToList();
        }
        else if (Enum.TryParse<EstadoPedido>(filtroEstadoStr, out var estadoEnum))
        {
            pedidosFiltrados = todosLosPedidos.Where(p => p.Estado == estadoEnum).ToList();
        }
    }

    private void SeleccionarPedido(PedidoDTO p)
    {
        pedidoSeleccionado = (pedidoSeleccionado?.Id == p.Id) ? null : p;
    }

    private void AbrirModalCalificar()
    {
        // Validar explícitamente que esté Entregado y que aún NO haya sido calificado
        if (pedidoSeleccionado == null || pedidoSeleccionado.Estado != EstadoPedido.Entregado || pedidoSeleccionado.CalificacionPedido.HasValue) return;

        califPedido = 5;
        califDelivery = 5;
        comentarioFinal = string.Empty;
        errorModal = null;
        mostrarModalCalificar = true;
    }

    private void CerrarModales()
    {
        mostrarModalCalificar = false;
        errorModal = null;
    }

    private async Task GuardarCalificacion()
    {
        if (pedidoSeleccionado == null) return;

        guardandoModal = true;
        errorModal = null;
        try
        {
            pedidoSeleccionado.CalificacionPedido = califPedido;
            if (pedidoSeleccionado.Modalidad == ModalidadPedido.Delivery)
            {
                pedidoSeleccionado.CalificacionDelivery = califDelivery;
            }

            pedidoSeleccionado.ComentarioFinal = comentarioFinal.Trim();

            await PedidoApiClient.UpdateAsync(pedidoSeleccionado);

            // Notificamos cambios
            Notificator.NotificarCambioPedidos();

            CerrarModales();
            await CargarMisPedidos();
        }
        catch (Exception ex)
        {
            errorModal = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            guardandoModal = false;
        }
    }

    private async Task CancelarPedido()
    {
        if (pedidoSeleccionado == null) return;

        try
        {
            pedidoSeleccionado.Estado = EstadoPedido.Cancelado;
            await PedidoApiClient.UpdateAsync(pedidoSeleccionado);

            // Notificamos cambios
            Notificator.NotificarCambioPedidos();

            await CargarMisPedidos();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cancelar pedido: {ex.Message}";
        }
    }

    private void NavegarNuevoPedido()
    {
        Navigation.NavigateTo("/cliente/hacer-pedido");
    }

    private string ObtenerBadgeEstado(EstadoPedido estado) => estado switch
    {
        EstadoPedido.Pendiente => "bg-warning text-dark",
        EstadoPedido.EnProceso => "bg-info text-dark",
        EstadoPedido.EnCamino => "bg-primary",
        EstadoPedido.Entregado => "bg-success",
        EstadoPedido.Cancelado => "bg-danger",
        _ => "bg-secondary"
    };
    // Estado de la ventana de edición
private bool mostrarModalEditar;
private bool guardandoEdicion;
private string? errorEdicion;

private ModalidadPedido modalidadEdicion = ModalidadPedido.TakeAway;
private string direccionEdicion = string.Empty;
private string comentarioEdicion = string.Empty;

private List<HamburguesaDTO> hamburguesasEdicion = new();
private List<ItemEdicionPedido> itemsEdicion = new();
private List<PrecioDeliveryDTO> preciosDeliveryEdicion = new();

private int hamburguesaIdEdicion;
private int cantidadEdicion = 1;
private decimal precioDeliveryEdicion;

private decimal TotalEdicion =>
    itemsEdicion.Sum(i => i.Cantidad * i.PrecioUnitario) +
    (modalidadEdicion == ModalidadPedido.Delivery ? precioDeliveryEdicion : 0m);

// Abre la ventana y carga los datos del pedido seleccionado
private async Task EditarPedido()
{
    if (pedidoSeleccionado == null ||
        pedidoSeleccionado.Estado != EstadoPedido.Pendiente)
        return;

    errorEdicion = null;

    try
    {
        var pedido = pedidoSeleccionado;

        modalidadEdicion = pedido.Modalidad;
        direccionEdicion = pedido.Direccion ?? string.Empty;
        comentarioEdicion = pedido.Comentario ?? string.Empty;

        // Copiamos los detalles y mantenemos sus precios históricos.
        itemsEdicion = pedido.DetallesPedido.Select(d => new ItemEdicionPedido
        {
            HamburguesaId = d.HamburguesaId,
            HamburguesaNombre = d.HamburguesaNombre,
            Cantidad = d.Cantidad,
            PrecioUnitario = d.PrecioUnitario
        }).ToList();

        var hamburguesas = await HamburguesaApiClient.GetAllAsync();
        hamburguesasEdicion = hamburguesas?
            .Where(h => h.Activo || itemsEdicion.Any(i => i.HamburguesaId == h.Id))
            .ToList() ?? new List<HamburguesaDTO>();

        var preciosDelivery = await PrecioDeliveryApiClient.GetByCriteriaAsync(null);
        preciosDeliveryEdicion = preciosDelivery?.ToList() ?? new List<PrecioDeliveryDTO>();

        precioDeliveryEdicion = ObtenerPrecioDelivery(
            pedido.Fecha,
            preciosDeliveryEdicion);

        hamburguesaIdEdicion = hamburguesasEdicion.FirstOrDefault()?.Id ?? 0;
        cantidadEdicion = 1;

        mostrarModalEditar = true;
    }
    catch (Exception ex)
    {
        errorEdicion = $"No se pudo cargar el pedido para editar: {ex.Message}";
    }
}

// Agrega una hamburguesa nueva o suma unidades si ya está en el pedido.
private void AgregarItemEdicion()
{
    if (pedidoSeleccionado == null)
        return;

    errorEdicion = null;

    if (hamburguesaIdEdicion <= 0)
    {
        errorEdicion = "Seleccioná una hamburguesa.";
        return;
    }

    if (cantidadEdicion < 1 || cantidadEdicion > 50)
    {
        errorEdicion = "La cantidad debe estar entre 1 y 50.";
        return;
    }

    var hamburguesa = hamburguesasEdicion
        .FirstOrDefault(h => h.Id == hamburguesaIdEdicion);

    if (hamburguesa == null)
    {
        errorEdicion = "No se encontró la hamburguesa seleccionada.";
        return;
    }

    var itemExistente = itemsEdicion
        .FirstOrDefault(i => i.HamburguesaId == hamburguesa.Id);

    if (itemExistente != null)
    {
        if (itemExistente.Cantidad + cantidadEdicion > 50)
        {
            errorEdicion = "No podés superar las 50 unidades de una hamburguesa.";
            return;
        }

        itemExistente.Cantidad += cantidadEdicion;
        return;
    }

    // Para los productos nuevos, usamos el precio correspondiente a la
    // fecha original del pedido, no el precio actual.
        var preciosHamburguesa = hamburguesa.Precios?.ToList()
        ?? new List<PrecioDTO>();
        var precioAplicable = hamburguesa.Precios?
            .Where(p => p.FechaDesde.Date <= pedidoSeleccionado.Fecha.Date)
            .OrderByDescending(p => p.FechaDesde)
            .FirstOrDefault();

        if (precioAplicable == null)
        {
            precioAplicable = hamburguesa.Precios?
                .Where(p => p.FechaDesde.Date > pedidoSeleccionado.Fecha.Date)
                .OrderBy(p => p.FechaDesde)
                .FirstOrDefault();
        }

        if (precioAplicable == null)
        {
            errorEdicion = "No hay precios registrados para esta hamburguesa.";
            return;
        }

    itemsEdicion.Add(new ItemEdicionPedido
    {
        HamburguesaId = hamburguesa.Id,
        HamburguesaNombre = hamburguesa.Nombre,
        Cantidad = cantidadEdicion,
        PrecioUnitario = precioAplicable.Monto
    });

    cantidadEdicion = 1;
}

private void EliminarItemEdicion(ItemEdicionPedido item)
{
    itemsEdicion.Remove(item);
    errorEdicion = null;
}

private void CerrarModalEdicion()
{
    if (guardandoEdicion)
        return;

    mostrarModalEditar = false;
    errorEdicion = null;
}

// Guarda los cambios utilizando el endpoint existente.
private async Task GuardarEdicionPedido()
{
    if (pedidoSeleccionado == null)
        return;

    if (pedidoSeleccionado.Estado != EstadoPedido.Pendiente)
    {
        errorEdicion = "Solo se pueden editar pedidos pendientes.";
        return;
    }

    if (itemsEdicion.Count == 0)
    {
        errorEdicion = "El pedido debe tener al menos una hamburguesa.";
        return;
    }

    if (itemsEdicion.Any(i => i.Cantidad < 1 || i.Cantidad > 50))
    {
        errorEdicion = "Cada cantidad debe estar entre 1 y 50.";
        return;
    }

    if (modalidadEdicion == ModalidadPedido.Delivery &&
        string.IsNullOrWhiteSpace(direccionEdicion))
    {
        errorEdicion = "Ingresá la dirección de entrega.";
        return;
    }

    guardandoEdicion = true;
    errorEdicion = null;

    // Guardamos una copia de los datos actuales por si falla la actualización.
    var pedido = pedidoSeleccionado;
    var modalidadAnterior = pedido.Modalidad;
    var direccionAnterior = pedido.Direccion;
    var comentarioAnterior = pedido.Comentario;
    var totalAnterior = pedido.PrecioTotal;
        var detallesAnteriores = pedido.DetallesPedido?.ToList()
        ?? new List<DetallePedidoDTO>();

    try
    {
        pedido.Modalidad = modalidadEdicion;
        pedido.Direccion = modalidadEdicion == ModalidadPedido.Delivery
            ? direccionEdicion.Trim()
            : null;
        pedido.Comentario = comentarioEdicion.Trim();
        pedido.DetallesPedido = itemsEdicion.Select(i => new DetallePedidoDTO
        {
            HamburguesaId = i.HamburguesaId,
            HamburguesaNombre = i.HamburguesaNombre,
            Cantidad = i.Cantidad,
            PrecioUnitario = i.PrecioUnitario
        }).ToList();
        pedido.PrecioTotal = TotalEdicion;

        await PedidoApiClient.UpdateAsync(pedido);

        Notificator.NotificarCambioPedidos();
        mostrarModalEditar = false;
        await CargarMisPedidos();
    }
    catch (Exception ex)
    {
        // Restauramos los datos visibles si la API devuelve un error.
        pedido.Modalidad = modalidadAnterior;
        pedido.Direccion = direccionAnterior;
        pedido.Comentario = comentarioAnterior;
        pedido.PrecioTotal = totalAnterior;
        pedido.DetallesPedido = detallesAnteriores;

        errorEdicion = $"Error al guardar los cambios: {ex.Message}";
    }
    finally
    {
        guardandoEdicion = false;
    }
}

// Representa una línea editable de la ventana.
private sealed class ItemEdicionPedido
{
    public int HamburguesaId { get; set; }
    public string HamburguesaNombre { get; set; } = string.Empty;
    public int Cantidad { get; set; }
    public decimal PrecioUnitario { get; set; }
}
private decimal ObtenerPrecioDelivery(
    DateTime fechaPedido,
    List<PrecioDeliveryDTO> precios)
{
    if (precios == null || precios.Count == 0)
        return 0m;

    var precioAplicable = precios
        .Where(p => p.FechaDesde.Date <= fechaPedido.Date)
        .OrderByDescending(p => p.FechaDesde)
        .FirstOrDefault();

    if (precioAplicable != null)
        return precioAplicable.Monto;

    // Si no hay un precio anterior a la fecha del pedido,
    // tomamos el primer precio futuro disponible.
    var primerPrecioFuturo = precios
        .Where(p => p.FechaDesde.Date > fechaPedido.Date)
        .OrderBy(p => p.FechaDesde)
        .FirstOrDefault();

    return primerPrecioFuturo?.Monto ?? 0m;
}
