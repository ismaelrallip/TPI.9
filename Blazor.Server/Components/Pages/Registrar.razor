@page "/registrar"
@rendermode InteractiveServer
@using System.Text.RegularExpressions
@using DTOs
@using API.Clients
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations

<PageTitle>Crear cuenta</PageTitle>

<div class="d-flex justify-content-center align-items-center min-vh-100 bg-light py-4">
    <div class="card shadow p-4" style="max-width: 500px; width: 100%;">
        <div class="text-center mb-4">
            <h3 class="fw-bold">Crear cuenta</h3>
            <p class="text-muted mb-0">Completá tus datos para registrarte</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div class="alert alert-danger py-2" role="alert">
                @mensajeError
            </div>
        }

        <EditForm Model="formulario" OnValidSubmit="RegistrarCliente">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label fw-bold">Nombre</label>
                <InputText class="form-control"
                           @bind-Value="formulario.Nombre"
                           disabled="@cargando"
                           maxlength="50" />
                <ValidationMessage For="@(() => formulario.Nombre)" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Apellido</label>
                <InputText class="form-control"
                           @bind-Value="formulario.Apellido"
                           disabled="@cargando"
                           maxlength="50" />
                <ValidationMessage For="@(() => formulario.Apellido)" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Email</label>
                <InputText class="form-control"
                           type="email"
                           @bind-Value="formulario.Email"
                           disabled="@cargando" />
                <ValidationMessage For="@(() => formulario.Email)" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Teléfono</label>
                <InputText class="form-control"
                           type="tel"
                           @bind-Value="formulario.Telefono"
                           disabled="@cargando"
                           placeholder="Solo números" />
                <ValidationMessage For="@(() => formulario.Telefono)" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Contraseña</label>
                <InputText class="form-control"
                           type="password"
                           @bind-Value="formulario.Password"
                           disabled="@cargando"
                           autocomplete="new-password" />
                <ValidationMessage For="@(() => formulario.Password)" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Confirmar contraseña</label>
                <InputText class="form-control"
                           type="password"
                           @bind-Value="confirmarPassword"
                           disabled="@cargando"
                           autocomplete="new-password" />

                @if (intentoEnviar &&
                                formulario.Password != confirmarPassword)
                {
                    <div class="text-danger small mt-1">
                        Las contraseñas no coinciden.
                    </div>
                }
            </div>

            <button type="submit"
                    class="btn btn-primary w-100 py-2 fw-bold"
                    disabled="@cargando">
                @if (cargando)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Registrando...</span>
                }
                else
                {
                    <span>CREAR CUENTA</span>
                }
            </button>
        </EditForm>

        <div class="text-center mt-3">
            <span class="text-muted">¿Ya tenés una cuenta?</span>
            <button type="button"
                    class="btn btn-link fw-bold text-decoration-none"
                    @onclick="VolverAlLogin"
                    disabled="@cargando">
                Iniciar sesión
            </button>
        </div>
    </div>
</div>

@code {
    private RegistroFormulario formulario = new();
    private string confirmarPassword = string.Empty;
    private string? mensajeError;
    private bool cargando;
    private bool intentoEnviar;

    private async Task RegistrarCliente()
    {
        intentoEnviar = true;
        mensajeError = null;

        formulario.Nombre = formulario.Nombre.Trim();
        formulario.Apellido = formulario.Apellido.Trim();
        formulario.Email = formulario.Email.Trim();
        formulario.Telefono = formulario.Telefono.Trim();

        if (formulario.Password != confirmarPassword)
        {
            mensajeError = "Las contraseñas no coinciden.";
            return;
        }

        if (formulario.Telefono.Length <= 8 ||
            !formulario.Telefono.All(char.IsDigit))
        {
            mensajeError = "El teléfono debe tener más de 8 dígitos y contener solo números.";
            return;
        }

        cargando = true;

        try
        {
            var cliente = new ClienteDTO
            {
                Nombre = formulario.Nombre,
                Apellido = formulario.Apellido,
                Email = formulario.Email,
                Telefono = formulario.Telefono,
                Password = formulario.Password
            };

            await ClienteApiClient.RegisterAsync(cliente);

            var emailRegistrado = Uri.EscapeDataString(cliente.Email);

            Navigation.NavigateTo(
                $"/login?email={emailRegistrado}&registrado=true");
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo completar el registro: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void VolverAlLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private sealed class RegistroFormulario
    {
        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "El nombre es obligatorio.")]
        [System.ComponentModel.DataAnnotations.StringLength(
            50, MinimumLength = 2,
            ErrorMessage = "El nombre debe tener entre 2 y 50 caracteres.")]
        public string Nombre { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "El apellido es obligatorio.")]
        [System.ComponentModel.DataAnnotations.StringLength(
            50, MinimumLength = 2,
            ErrorMessage = "El apellido debe tener entre 2 y 50 caracteres.")]
        public string Apellido { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "El email es obligatorio.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(
            ErrorMessage = "El formato del email no es válido.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "La contraseña es obligatoria.")]
        [System.ComponentModel.DataAnnotations.MinLength(
            6, ErrorMessage = "La contraseña debe tener al menos 6 caracteres.")]
        public string Password { get; set; } = string.Empty;

        public string Telefono { get; set; } = string.Empty;
    }
}
