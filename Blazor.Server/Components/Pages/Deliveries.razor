@page "/deliveries"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]

<PageTitle>Gestión de Deliveries</PageTitle>

<div class="container-fluid p-4">
    <h3 class="mb-4">Gestión de Deliveries</h3>

    <!-- Barra de búsqueda superior -->
    <div class="row mb-3">
        <div class="col-md-5 d-flex gap-2">
            <input type="text" class="form-control" placeholder="Buscar por nombre, apellido, teléfono o DNI..."
                   @bind="textoBusqueda" @bind:event="oninput" />
            <button class="btn btn-outline-secondary" @onclick="CargarDeliveries">Buscar</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger" role="alert">
            @mensajeError
        </div>
    }

    <!-- Grilla tipo DataGridView -->
    <div class="border rounded bg-white shadow-sm mb-3" style="max-height: 450px; overflow-y: auto;">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-dark position-sticky top-0">
                <tr>
                    <th style="width: 50px;"></th>
                    <th style="width: 80px;">Id</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Teléfono</th>
                    <th>DNI</th>
                </tr>
            </thead>
            <tbody>
                @if (cargando)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span class="ms-2">Cargando...</span>
                        </td>
                    </tr>
                }
                else if (!DeliveriesFiltrados.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            No se encontraron registros.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var d in DeliveriesFiltrados)
                    {
                        var seleccionado = deliverySeleccionado?.IdDelivery == d.IdDelivery;

                        <tr class="@(seleccionado ? "table-primary fw-bold" : "")" style="cursor: pointer;"
                            @onclick="() => SeleccionarDelivery(d)">
                            <td class="text-center">
                                @if (seleccionado)
                                {
                                    <span>▶</span>
                                }
                            </td>
                            <td>@d.IdDelivery</td>
                            <td>@d.Nombre</td>
                            <td>@d.Apellido</td>
                            <td>@d.Telefono</td>
                            <td>@d.Dni</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Botones de Acción -->
    <div class="d-flex justify-content-center gap-2">
        <button class="btn btn-outline-danger px-4 fw-bold" disabled="@(deliverySeleccionado == null)"
                @onclick="AbrirModalConfirmarEliminar">
            Eliminar
        </button>

        <button class="btn btn-outline-warning px-4 fw-bold" disabled="@(deliverySeleccionado == null)"
                @onclick="AbrirModalModificar">
            Actualizar
        </button>

        <button class="btn btn-primary px-4 fw-bold" @onclick="AbrirModalAgregar">
            Agregar
        </button>
    </div>
</div>

@* ==========================================
   MODAL 1: AGREGAR / ACTUALIZAR DELIVERY
   ========================================== *@
@if (mostrarModalFormulario)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title">@(esEdicion ? "Actualizar delivery" : "Agregar delivery")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(errorModal))
                    {
                        <div class="alert alert-danger py-2">@errorModal</div>
                    }

                    @if (esEdicion)
                    {
                        <div class="mb-3 row">
                            <label class="col-sm-4 col-form-label fw-bold">Id</label>
                            <div class="col-sm-8">
                                <input type="text" class="form-control" value="@deliverySeleccionado?.IdDelivery" disabled />
                            </div>
                        </div>
                    }

                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-bold">Nombre</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" @bind="formNombre" />
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-bold">Apellido</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" @bind="formApellido" />
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-bold">Teléfono</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" @bind="formTelefono" />
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-bold">DNI</label>
                        <div class="col-sm-8">
                            <input type="text" inputmode="numeric" pattern="[0-9]*" class="form-control" @bind="formDni" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModales" disabled="@guardando">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-primary fw-bold" @onclick="GuardarDelivery" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Aceptar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ==========================================
   MODAL 2: CONFIRMAR ELIMINACIÓN
   ========================================== *@
@if (mostrarModalEliminar && deliverySeleccionado != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body text-center">
                    <div class="display-6 text-primary mb-2">?</div>
                    <p class="mb-0">¿Eliminar a @deliverySeleccionado.Nombre @deliverySeleccionado.Apellido?</p>
                </div>
                <div class="modal-footer d-flex justify-content-center">
                    <button type="button" class="btn btn-primary px-3" @onclick="EliminarDeliveryConfirmado"
                            disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Sí
                    </button>
                    <button type="button" class="btn btn-secondary px-3" @onclick="CerrarModales" disabled="@guardando">
                        No
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DeliveryDTO> listaDeliveries = new();
    private DeliveryDTO? deliverySeleccionado;
    private string textoBusqueda = string.Empty;
    private bool cargando = true;
    private string? mensajeError;

    // Modales
    private bool mostrarModalFormulario;
    private bool mostrarModalEliminar;
    private bool esEdicion;
    private bool guardando;
    private string? errorModal;

    // Campos formulario
    private string formNombre = string.Empty;
    private string formApellido = string.Empty;
    private string formTelefono = string.Empty;
    private int formDni;

    // Filtro reactivo local
    private IEnumerable<DeliveryDTO> DeliveriesFiltrados =>
        string.IsNullOrWhiteSpace(textoBusqueda)
            ? listaDeliveries
            : listaDeliveries.Where(d =>
                (!string.IsNullOrEmpty(d.Nombre) && d.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(d.Apellido) && d.Apellido.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(d.Telefono) && d.Telefono.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)) ||
                d.Dni.ToString().Contains(textoBusqueda));

    protected override async Task OnInitializedAsync()
    {
        await CargarDeliveries();
    }

    private async Task CargarDeliveries()
    {
        cargando = true;
        mensajeError = null;
        try
        {
            var resultado = string.IsNullOrWhiteSpace(textoBusqueda)
                ? await DeliveryApiClient.GetAllAsync()
                : await DeliveryApiClient.GetByCriteriaAsync(textoBusqueda.Trim());
            listaDeliveries = resultado.ToList();
            deliverySeleccionado = null;
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar los deliveries: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void SeleccionarDelivery(DeliveryDTO delivery)
    {
        deliverySeleccionado = (deliverySeleccionado?.IdDelivery == delivery.IdDelivery) ? null : delivery;
    }

    private void AbrirModalAgregar()
    {
        esEdicion = false;
        formNombre = string.Empty;
        formApellido = string.Empty;
        formTelefono = string.Empty;
        formDni = 0;
        errorModal = null;
        mostrarModalFormulario = true;
    }

    private void AbrirModalModificar()
    {
        if (deliverySeleccionado == null) return;

        esEdicion = true;
        formNombre = deliverySeleccionado.Nombre;
        formApellido = deliverySeleccionado.Apellido;
        formTelefono = deliverySeleccionado.Telefono;
        formDni = deliverySeleccionado.Dni;
        errorModal = null;
        mostrarModalFormulario = true;
    }

    private void AbrirModalConfirmarEliminar()
    {
        if (deliverySeleccionado == null) return;
        mostrarModalEliminar = true;
    }

    private void CerrarModales()
    {
        mostrarModalFormulario = false;
        mostrarModalEliminar = false;
        errorModal = null;
    }

    private async Task GuardarDelivery()
    {
        if (string.IsNullOrWhiteSpace(formNombre) || string.IsNullOrWhiteSpace(formApellido))
        {
            errorModal = "El nombre y el apellido son obligatorios.";
            return;
        }

        if (formDni <= 0)
        {
            errorModal = "Debe ingresar un DNI válido mayor a 0.";
            return;
        }

        guardando = true;
        errorModal = null;

        try
        {
            if (esEdicion && deliverySeleccionado != null)
            {
                var dto = new DeliveryDTO
                {
                    IdDelivery = deliverySeleccionado.IdDelivery,
                    Nombre = formNombre,
                    Apellido = formApellido,
                    Telefono = formTelefono,
                    Dni = formDni
                };

                await DeliveryApiClient.UpdateAsync(dto);
            }
            else
            {
                var dto = new DeliveryDTO
                {
                    Nombre = formNombre,
                    Apellido = formApellido,
                    Telefono = formTelefono,
                    Dni = formDni
                };

                await DeliveryApiClient.AddAsync(dto);
            }

            CerrarModales();
            await CargarDeliveries();
        }
        catch (Exception ex)
        {
            errorModal = $"Error al guardar delivery: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarDeliveryConfirmado()
    {
        if (deliverySeleccionado == null) return;

        guardando = true;
        errorModal = null;

        try
        {
            await DeliveryApiClient.DeleteAsync(deliverySeleccionado.IdDelivery);
            CerrarModales();
            await CargarDeliveries();
        }
        catch (Exception ex)
        {
            errorModal = $"Error al eliminar delivery: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }
}